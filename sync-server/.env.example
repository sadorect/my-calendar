# Copy to .env beside docker-compose.yml and fill in. Never commit the result.

# Postgres password for the calendar_sync database (generate, do not choose).
POSTGRES_PASSWORD=

# Signs bearer tokens; 32+ random characters. Rotating it signs every device out.
TOKEN_SECRET=

# Exact origins allowed to call the API, comma-separated. The deployed app's
# origin — not the API's own hostname.
ALLOWED_ORIGINS=https://my-birthcalendar.vercel.app

# 0 closes signup once your own accounts exist.
ALLOW_REGISTRATION=1
